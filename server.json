{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.elchin92/avito-mcp",
  "description": "Avito API MCP for AI agents — 148 tools, safe-by-default, stdio or remote HTTP (OAuth 2.1).",
  "repository": {
    "url": "https://github.com/elchin92/avito-mcp",
    "source": "github"
  },
  "version": "1.3.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "avito-mcp",
      "version": "1.3.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Avito OAuth client_id (from https://www.avito.ru/professionals/api).",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "Client_id"
        },
        {
          "description": "Avito OAuth client_secret (from https://www.avito.ru/professionals/api).",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "Client_secret"
        },
        {
          "description": "Avito profile id (numeric account id); auto-injected into {user_id}/{userId} path params.",
          "isRequired": true,
          "format": "string",
          "isSecret": false,
          "name": "Profile_id"
        },
        {
          "description": "Which MCP protocol revisions this process serves: legacy = 2025-11-25 only, dual = 2025-11-25 and 2026-07-28, modern = 2026-07-28 only.",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "default": "legacy",
          "choices": ["legacy", "dual", "modern"],
          "name": "AVITO_MCP_PROTOCOL_ERA"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "protocolRevisions": {
        "served": ["2026-07-28", "2025-11-25"],
        "servedByDefault": ["2025-11-25"],
        "selectedBy": {
          "environmentVariable": "AVITO_MCP_PROTOCOL_ERA",
          "default": "legacy",
          "values": {
            "legacy": ["2025-11-25"],
            "dual": ["2026-07-28", "2025-11-25"],
            "modern": ["2026-07-28"]
          }
        },
        "documentation": "https://github.com/elchin92/avito-mcp#protocol-revisions"
      }
    }
  }
}
