# avito-mcp v0.9.0 — reverse proxy + automatic HTTPS for the remote MCP + webhook.
# Caddy fetches a Let's Encrypt cert for mcp.example.com automatically (needs the
# DNS A-record pointing here AND inbound TCP 80+443 reachable from the internet),
# then proxies every path (/mcp, /.well-known/*, /authorize, /token, /register,
# /avito/webhook/*, /healthz) to the Node server on localhost:3000. Caddy preserves
# the Host header by default, which the OAuth metadata + DNS-rebinding checks rely on.

mcp.example.com {
	encode gzip

	# Access log — the ONLY place a request's status, duration and protocol era
	# are recorded. The Node process writes no per-request line at any log level,
	# so every quantitative rollback criterion in docs/adr/0007-rollback-criteria.md
	# is computed from these entries via `journalctl -u caddy -o cat | jq`.
	#
	# `output stderr` and `format json` are spelled out rather than left to the
	# defaults, and that is not style. A bare `log` inherits Caddy's shared
	# default logger, which drops entries under even light load — measured on
	# v2.11.3: 30 requests produced 3 log lines. With both directives given, 30
	# of 30 were recorded. A sampled access log turns every ratio and percentile
	# in that document into a fiction.
	#
	# Credentials do not enter it: Caddy records `Authorization` and `Cookie` as
	# REDACTED (verified by sending both) because `log_credentials` is off, and
	# it must stay off. The webhook's only credential is not a header at all —
	# Avito's protocol carries no signature, so the secret is the last segment of
	# the URL PATH, and `request.uri` is recorded verbatim. Hence the log_skip.
	#
	# The matcher is a bare PREFIX on purpose. Measured on v2.11.3, one request
	# per path, with `log_skip /avito/webhook/*`: `/avito/webhook/<secret>` is
	# skipped, but a SECOND receiver mounted beside it —
	# `/avito/webhook-mondigo/<secret>` — is logged in full, and so is the bare
	# `/avito/webhook`. With `log_skip /avito/webhook*` all three are skipped
	# while `/mcp` and `/healthz` are still recorded. `/avito/webhook*/*` is not
	# a fix: it puts `/avito/webhook/nested/<secret>` back in the log.
	#
	# A host with several receivers needs EVERY receiver's path covered: this one
	# runs avito-mcp.service (:3000) and avito-mcp-mondigo.service (:3001), and a
	# single matcher covers both only because both mount under `/avito/webhook`.
	# If AVITO_MCP_WEBHOOK_PATH moves a receiver off that prefix, add a matcher
	# for the new path as well.
	#
	# log_skip suppresses the ACCESS log only. When the upstream is down — which
	# is exactly what the restarts in docs/adr/0007-rollback-criteria.md §6.1/§6.2
	# produce — Caddy writes an `http.log.error.*` entry that still carries the
	# full URI, secret included, into journald. That is a pre-existing defect this
	# matcher does not close; treat the secret as disclosed to anyone who can read
	# the journal across a restart, and rotate it if that has happened.
	#
	# Request headers ARE recorded, which is what allows the log to be split by
	# era on `Mcp-Protocol-Version` the same way the server's own classifier does.
	log {
		output stderr
		format json
	}
	log_skip /avito/webhook*

	reverse_proxy 127.0.0.1:3000
}
