# Keep the build context lean and never leak local secrets into the image.
node_modules
dist
coverage
.git
.github
.claude
test
swaggers/*.local.json

# Research material for the protocol migration — never part of a runtime image.
# The Dockerfile also copies docs/ file by file, so this is a second barrier.
docs/mcp-2026-07-28
MIGRATION_PLAN.md
MIGRATION_PROGRESS.md

# Secrets / local state — MUST never enter the image.
.env*
!.env.example
.remote.env*
.npmrc*
.avito-token.json*
.mcp.json*
!.mcp.json.example
*.pem
*.pem.*
*.key
*.key.*
*.jsonl
deploy/Caddyfile
PROJECT_AUDIT.md
AUDIT-*.md
*.tgz
logs
*.log

# Editor / OS
.DS_Store
.vscode
.idea
